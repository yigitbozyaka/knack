# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / IDEs
.vscode/
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
*.swo
*~

# os
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# local notes, plans, scratch (not for upstream)
/.claude/
/.cursor/
/notes/
/plans/
/scratch/
/tmp/
TODO.local.md
NOTES.local.md

# secrets / credentials
*.pem
*.key
*.crt
secrets/

# build/test artifacts
/playwright/.cache/
.turbo/
.eslintcache
