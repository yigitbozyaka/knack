# =============================================================================
# Knack — environment variables
#
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser; everything
# else is server-only.
#
# All values are validated at startup by `lib/env.ts` (Zod). The app will
# refuse to boot if anything required is missing or invalid.
# =============================================================================

# ---- Runtime ---------------------------------------------------------------
# `development` | `test` | `production`. Next.js sets this automatically when
# you run `next dev` / `next build` / `next start` — only override for tests.
NODE_ENV=development

# ---- Public URL ------------------------------------------------------------
# The fully-qualified URL the app is served from. Used for absolute links,
# OG metadata, and any `new URL(..., env.NEXT_PUBLIC_APP_URL)` calls.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Postgres --------------------------------------------------------------
# Postgres connection string. Locally this points at the docker-compose
# service; in production point it at Neon (or any Postgres provider).
DATABASE_URL=postgres://knack:knack@localhost:5432/knack

# ---- S3-compatible object storage (Cloudflare R2 / MinIO) ------------------
# Endpoint, region and credentials for the S3-compatible bucket Knack uses for
# uploads. In dev these point at MinIO; in production at Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=knack
# Public base URL for served bucket objects (used to construct download links).
S3_PUBLIC_URL=http://localhost:9000/knack

# ---- Sessions --------------------------------------------------------------
# Name of the cookie that holds the session id.
SESSION_COOKIE_NAME=knack_session
# Secret used to sign session cookies. MUST be at least 32 characters.
# Generate one with: `openssl rand -base64 48` or `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`.
SESSION_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars

# ---- Rate limiting ---------------------------------------------------------
# Counters live in the `rate_limits` Postgres table; no extra service needed.
# Master toggle. `true` | `false` | `1` | `0`. Defaults to `true`.
RATE_LIMIT_ENABLED=true
# Salt mixed into the daily IP hash so the table isn't a tracking ledger.
# MUST be at least 32 characters. Rotate if leaked.
# Generate one with: `openssl rand -base64 48`.
RATE_LIMIT_SALT=replace-me-with-a-long-random-string-of-at-least-32-chars

# ---- Cron secret -----------------------------------------------------------
# Bearer token required by /api/cron/expire and any future cron handlers. The
# scheduler must send `Authorization: Bearer ${CRON_SECRET}`.
# MUST be at least 32 characters. Rotate by rolling this value AND updating
# every scheduler that hits the cron endpoints.
# Generate one with: `openssl rand -base64 48`.
CRON_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
